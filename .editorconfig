; KYAI editor defaults. Keeps whitespace consistent across editors so pull
; request diffs stay small. Formatting of code is handled by Prettier
; (.prettierrc.json); this file covers what Prettier does not.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
; Trailing spaces can be meaningful line breaks in Markdown.
trim_trailing_whitespace = false

[data/*.json]
; Written by scripts with JSON.stringify(value, null, 2).
indent_size = 2

[*.{yml,yaml}]
indent_size = 2
