# KYAI local environment example
# Copy to .env and fill in real values.

# Database: SQLite locally, or Vercel Postgres in production.
# Examples:
#   DATABASE_URL=file:./kyai.db
#   DATABASE_URL=postgres://user:pass@host/db
DATABASE_URL=file:./kyai.db

# Optional: OpenAI key for the /api/v1/ingest URL extraction endpoint.
# If omitted, ingest falls back to basic heuristic extraction.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Optional: comma-separated allowed CORS origins. Defaults to *.
KYAI_ALLOWED_ORIGINS=*

# Newsletter email (Resend). Required for welcome emails and the weekly digest.
# See the Newsletter Signup section in README.md for setup.
# RESEND_API_KEY=<redacted>
# KYAI_RESEND_AUDIENCE_ID=<redacted>
# KYAI_NEWSLETTER_FROM=KYAI <updates@kyai.com>
# KYAI_NEWSLETTER_NOTIFY_TO=kahlil@getmoneybot.com
# Optional: send the weekly digest to one address instead of broadcasting.
# KYAI_NEWSLETTER_TEST_TO=<redacted>
