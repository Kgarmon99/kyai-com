# KYAI local environment example
# Copy to .env and fill in real values.

# Database: SQLite locally, or Vercel Postgres in production.
# Examples:
#   DATABASE_URL=file:./kyai.db
#   DATABASE_URL=postgres://user:pass@host/db
DATABASE_URL=file:./kyai.db

# Optional: OpenAI key for the /api/v1/ingest URL extraction endpoint.
# If omitted, ingest falls back to basic heuristic extraction.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Optional: comma-separated allowed CORS origins. Defaults to *.
KYAI_ALLOWED_ORIGINS=*

# Subscriber records are personal data. They live in the database and, in
# development only, in an optional local mirror. That mirror must never be a
# tracked path: this repository is public and the live site is built from it.
# Defaults to .local/subscribers.json, which is gitignored. Set to "off" to
# disable the mirror entirely.
KYAI_SUBSCRIBER_FILE=

# Newsletter email (Resend). Required for welcome emails and the weekly digest.
# See the Newsletter Signup section in README.md for setup.
# NOTIFY_TO and GITHUB_REPO have no built-in defaults, so a fork can never
# deliver its subscribers to the upstream KYAI maintainers by accident.
# RESEND_API_KEY=<redacted>
# KYAI_RESEND_AUDIENCE_ID=<redacted>
# KYAI_NEWSLETTER_FROM=KYAI <updates@kyai.com>
# KYAI_NEWSLETTER_NOTIFY_TO=you@example.com
# Optional: send the weekly digest to one address instead of broadcasting.
# KYAI_NEWSLETTER_TEST_TO=<redacted>

# Weekly send auth. Vercel Cron sends this as a Bearer token to
# /api/send-weekly-newsletter. Set the same value in Vercel project settings.
# CRON_SECRET=<random string, at least 16 characters>
