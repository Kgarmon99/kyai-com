# KYAI local environment example
# Copy to .env and fill in real values.

# Database: SQLite locally, or Vercel Postgres in production.
# Examples:
#   DATABASE_URL=file:./kyai.db
#   DATABASE_URL=postgres://user:pass@host/db
DATABASE_URL=file:./kyai.db

# Optional: OpenAI key for the /api/v1/ingest URL extraction endpoint.
# If omitted, ingest falls back to basic heuristic extraction.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Optional: comma-separated allowed CORS origins. Defaults to *.
KYAI_ALLOWED_ORIGINS=*
